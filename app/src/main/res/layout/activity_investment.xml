<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Экран тақырыбы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Инвестициялық табыстылық"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <!-- Бастапқы инвестициялар -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Инвестиция сомасы (₸)"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etInvestment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Инвестиция сомасын енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- Түскен табыс -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Табыс (₸)"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Инвестициядан түскен табысты енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- ROI есептеу түймесі -->
        <Button
            android:id="@+id/btnCalculateROI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ИТ есептеу"
            android:layout_marginBottom="24dp"/>

        <!-- Нәтиже -->
        <TextView
            android:id="@+id/tvROIResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Инвестициялық табыс(ИТ): "
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
