<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Экран тақырыбы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бюджеттеу"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <!-- Табыс енгізу өрісі -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Табыс"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Табыс сомасын енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- Шығын енгізу өрісі -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Шығын"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Шығын сомасын енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- Бюджет сальдосын есептеу түймесі -->
        <Button
            android:id="@+id/btnCalculateBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сальдоны есептеу"
            android:layout_marginBottom="16dp"/>

        <!-- Нәтижені көрсету мәтіні -->
        <TextView
            android:id="@+id/tvBudgetResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бюджет сальдосы: "
            android:textSize="18sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50% (Жинақ/Инвестициялар): "
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvBudget50Percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30% (Негізгі шығындар): "
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvBudget30Percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20% (Икемді шығындар/Көңіл көтеру): "
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvBudget20Percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
