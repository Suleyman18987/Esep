<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Экран тақырыбы -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Қарыз жүктемесі"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp"/>

        <!-- Ай сайынғы төлемдер сомасы өрісі -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ай сайынғы төлемдер сомасы"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etDebtPayments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Төлем сомасын енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- Ай сайынғы табыс өрісі -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ай сайынғы табыс"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/etMonthlyIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Табыс мөлшерін енгізіңіз"
            android:layout_marginBottom="16dp"/>

        <!-- DTI есептеу түймесі -->
        <Button
            android:id="@+id/btnCalculateDebt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ҚТҚ есептеу"
            android:layout_marginBottom="24dp"/>

        <!-- Нәтиже үшін мәтін -->
        <TextView
            android:id="@+id/tvDTIResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Қарыз/Табыс қатынасы (ҚТҚ): "
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
